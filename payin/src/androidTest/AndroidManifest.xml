<?xml version="1.0" encoding="utf-8"?>
<!--
  Test APK only, as `:core`'s is. This manifest is never merged into a consumer, so the library manifest stays
  empty and the host-declares-INTERNET position is unaffected: an app embedding `:payin` still declares its own
  permission. The live tier asks a token server for a token and submits real payments over HTTPS, so the test
  process genuinely needs INTERNET, and without it every one of those tests fails as `SecurityException` rather
  than as anything about a payment.

  The config permits cleartext to a token server on loopback and nowhere else. See the file for why that is
  required rather than tidy.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
