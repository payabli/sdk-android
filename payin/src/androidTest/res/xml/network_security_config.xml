<?xml version="1.0" encoding="utf-8"?>
<!--
  The live tier asks a token server for a token, and that server speaks http. Cleartext is denied by default:
  the platform's base-config is cleartextTrafficPermitted="false" from targetSdk 28, and the implicit loopback
  exemption arrives only in API 37, so at this module's floor of 23 an explicit entry is required.

  Only the token server is reached this way. Every payment the tier submits goes to the environment over HTTPS
  and is unaffected by this file.

  Scoped to the two addresses a token server is reached at rather than a blanket usesCleartextTraffic, so a
  test cannot take a plaintext route to a real host. What makes it safe is the file: it belongs to the
  androidTest APK alone, is never merged into the library or into a consuming app, and widens nothing that
  ships. `:core` carries the same pair for its loopback harness.
-->
<network-security-config>
    <!-- Explicit because the default varies by targetSdk: denied from 28, permitted at 27 and below. -->
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <!-- The device's own loopback. A handset reaches the development machine here once
             `adb reverse tcp:8787 tcp:8787` is forwarding. -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- The emulator's alias for the loopback interface of the machine running it, which is where CI
             starts the server. Two addresses rather than one because they reach different hosts: 127.0.0.1 is
             inside the device, while 10.0.2.2 is the only address that reaches a process outside it. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
