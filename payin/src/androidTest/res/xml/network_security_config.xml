<?xml version="1.0" encoding="utf-8"?>
<!--
  The live tier asks a token server for a token, and that server speaks http. Cleartext is denied by default
  from targetSdk 28, and the implicit loopback exemption arrives only in API 37, so an explicit entry is
  required on every level this runs on.

  It does nothing at this module's floor. `android:networkSecurityConfig` was added in API 24, so at 23 the
  file is not read at all, and nothing is needed there because cleartext is permitted by default that far
  back. `:example` sets its own floor to 24 for the same reason.

  Only the token server is reached this way. Every payment the tier submits goes to the environment over HTTPS
  and is unaffected by this file.

  Scoped to the two addresses a token server is reached at rather than a blanket usesCleartextTraffic. That
  narrows what is reachable in cleartext; it does not make the pair unreachable, since 10.0.2.2 is an ordinary
  RFC 1918 address and routable on any network using 10.0.0.0/8. What makes it safe is the file: it belongs to
  the androidTest APK alone, is never merged into the library or into a consuming app, and widens nothing that
  ships. `:core` carries the same pair, and says the same thing about the second address.
-->
<network-security-config>
    <!-- Explicit because the default varies by targetSdk: denied from 28, permitted at 27 and below. -->
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <!-- The device's own loopback. A handset reaches the development machine here once
             `adb reverse tcp:8787 tcp:8787` is forwarding. -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- The emulator's alias for the loopback interface of the machine running it, which is where CI
             starts the server. Two addresses rather than one because they reach different hosts: 127.0.0.1 is
             inside the device, while 10.0.2.2 is the only address that reaches a process outside it. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
