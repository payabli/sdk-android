<?xml version="1.0" encoding="utf-8"?>
<!--
  The token server speaks http. Cleartext is denied by default from targetSdk 28, and the implicit loopback
  exemption only arrives in API 37, so an explicit entry is required at this module's floor of 30.

  Scoped to the one address instead of a blanket usesCleartextTraffic, so no plaintext route to a real host
  is reachable. This file belongs to the androidTest APK alone and is never merged into the library or a
  consuming app.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- The device's own loopback. `adb reverse tcp:8787 tcp:8787` forwards it to the development
             machine, so the token server is reached without naming a host. -->
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
