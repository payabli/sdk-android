<?xml version="1.0" encoding="utf-8"?>
<!--
    Merged into the instrumentation APK only, never into a consumer's. The library's own manifest stays
    empty and the host app still declares its own permissions.

    The live tier reaches the service over HTTPS and the development machine's token server over HTTP,
    on loopback via `adb reverse`. Cleartext is denied by default, so that one address is permitted in
    res/xml/network_security_config.xml and nothing else is.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
