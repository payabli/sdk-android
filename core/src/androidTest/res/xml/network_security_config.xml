<?xml version="1.0" encoding="utf-8"?>
<!--
  The loopback harness speaks http, and cleartext is denied by default: the platform's base-config is
  cleartextTrafficPermitted="false" from targetSdk 28, and this module's tests build against a far higher
  compileSdk. The implicit loopback exemption arrives only in API 37, so at this module's floor of 23 an
  explicit entry is required rather than merely tidy.

  Scoped to the single address the harness binds instead of a blanket usesCleartextTraffic, so nothing but
  the harness is reachable in cleartext and a test cannot accidentally exercise a plaintext route to a
  real host.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Matching the one address LoopbackServer binds. It pins 127.0.0.1 and builds its base URL from
             that literal, so the address form is what has to match and no name is involved. Widen this
             only alongside the bind, never ahead of it. -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- The emulator's alias for the development machine's loopback interface, for the manual tier's
             stand-in broker. Two addresses rather than one because they reach different hosts, not because
             they are two spellings of one: 127.0.0.1 is the device's own loopback, so a server bound there
             is inside the device, while 10.0.2.2 is the only address that reaches a process on the machine
             running the emulator. A test measuring a round trip to a separate host needs the second.

             What makes this safe is the file, not the address: this config belongs to the androidTest APK
             alone, is never merged into the library or into a consuming app, and so widens nothing that
             ships. 10.0.2.2 is an ordinary RFC 1918 address, routable on any network using 10.0.0.0/8, so
             it is not inherently unreachable anywhere. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
