<?xml version="1.0" encoding="utf-8"?>
<!--
  The loopback harness speaks http, and cleartext is denied by default: the platform's base-config is
  cleartextTrafficPermitted="false" from targetSdk 28, and this module's tests build against a far higher
  compileSdk. The implicit loopback exemption arrives only in API 37, so at this module's floor of 23 an
  explicit entry is required rather than merely tidy.

  Scoped to the loopback names instead of a blanket usesCleartextTraffic, so nothing but the harness is
  reachable in cleartext and a test cannot accidentally exercise a plaintext route to a real host.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- LoopbackServer binds InetAddress.getLoopbackAddress() and builds its base URL from the
             resulting literal, so the address form is what has to match, not the name. Both families
             are listed because which one that call yields is a platform choice, not ours. -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">::1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
