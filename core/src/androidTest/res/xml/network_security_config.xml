<?xml version="1.0" encoding="utf-8"?>
<!--
  The loopback harness speaks http, and cleartext is denied by default: the platform's base-config is
  cleartextTrafficPermitted="false" from targetSdk 28, and this module's tests build against a far higher
  compileSdk. The implicit loopback exemption arrives only in API 37, so at this module's floor of 23 an
  explicit entry is required rather than merely tidy.

  Scoped to the single address the harness binds instead of a blanket usesCleartextTraffic, so nothing but
  the harness is reachable in cleartext and a test cannot accidentally exercise a plaintext route to a
  real host.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Matching the one address LoopbackServer binds. It pins 127.0.0.1 and builds its base URL from
             that literal, so the address form is what has to match and no name is involved. Widen this
             only alongside the bind, never ahead of it. -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- The emulator's alias for the development machine's loopback interface, for the manual tier's
             stand-in broker. Two addresses rather than one because they are different paths, not two
             spellings: 127.0.0.1 is the device's own loopback and never crosses the emulator's virtual
             router, so it is not affected by any bandwidth profile. Only traffic to 10.0.2.2 is shaped,
             which is why a test that has to measure a slow link cannot use the in-process harness. This
             address resolves to nothing on a physical device, so it widens no phone's reachable surface. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
