.DS_Store

# Built application files
*.apk
*.ap_

# Files for the Dalvik VM
*.dex

# Java class files
*.class

# PyCache files
__pycache__/

# Generated files
bin/
gen/
javadoc/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Claude AI settings
.claude/settings.local.json
.claude/worktrees/

# Proguard folder generated by Eclipse
proguard/

# Intellij
*.iml
*.ipr
*.iws
# .idea/* rather than .idea: git cannot re-include a path whose parent directory is
# excluded, so the negation below only works if the directory itself stays listed.
.idea/*
!.idea/dictionaries/

# Cursor IDE
.cursor/
.agent/

.kotlin/sessions
.kotlin/errors

# Git worktrees
.worktrees/