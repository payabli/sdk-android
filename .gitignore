.DS_Store

# Built application files
*.apk
*.ap_

# Files for the Dalvik VM
*.dex

# Java class files
*.class

# PyCache files
__pycache__/

# Generated files
bin/
gen/
javadoc/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Claude AI settings
.claude/settings.local.json
.claude/worktrees/

# Proguard folder generated by Eclipse
proguard/

# Intellij
*.iml
*.ipr
*.iws
# .idea/* rather than .idea: git cannot re-include a path whose parent directory is
# excluded, so the negation below only works if the directory itself stays listed.
.idea/*
!.idea/dictionaries/

# Cursor IDE
.cursor/
.agent/

.kotlin/sessions
.kotlin/errors

# Git worktrees
.worktrees/

# Local credentials for the example token server. Repeated at the repository root rather than left to
# example-server/.gitignore alone: this repository is public, and a nested ignore stops protecting a file
# the moment the directory is copied or moved. The template stays tracked.
.env
.env.*
!.env.example

# Per-developer settings for the sample app. Kept at the repository root for the same reason as the
# .env rules above. The template stays tracked.
example/secrets.properties
