# Copy to secrets.properties and fill in. secrets.properties is gitignored.
#
# Do not put a client secret here. A partner's client secret must never ship inside a mobile binary.
# Run example-server instead: it performs the exchange and hands this app a short-lived token.
# See example-server/README.md.
#
# Every setting below can also be passed for a single run without editing this file:
#   ./gradlew :example:installDebug -Ppayabli.demo.entryPoint=test6

# Partner integration identifier.
payabli.demo.entryPoint=

# This app's package name. The tap-to-pay readiness check compares it against the package actually
# running and against this binary's signing certificate, so a mismatch shows up on screen instead of
# being rejected much later by attestation.
payabli.demo.appId=com.payabli.example.app

# Where the token server is. Blank resolves per run: an emulator reaches this machine at 10.0.2.2,
# and a physical device reaches it at 127.0.0.1 once `adb reverse tcp:8787 tcp:8787` is set up.
# Set a bare host, host:port, or a full URL to pin it, which is what a LAN address needs.
payabli.demo.tokenHost=

# Redacted request and response logging on the payment screens.
payabli.demo.diagnostics=true
