<?xml version="1.0" encoding="utf-8"?>
<!--
  The round launcher icon on API 24 and 25. See `ic_launcher.xml` beside this file for why it exists.

  Round is the shape the launcher asks for, so the background is a circle and the mark sits on it.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ic_launcher_background" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
