<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Package visibility, required from API 30. The tap-to-pay readiness screen reports whether Play
      services and the Play Store are installed, because integrity verification needs both. Without
      these two entries getPackageInfo throws NameNotFoundException and the check would report them
      absent on a device that has them. Visibility only: no permission, and nothing is read from
      either package.

      No NFC permission is declared. The same screen reads NFC through hasSystemFeature and
      NfcManager, neither of which requires one, and an unused permission in a sample app is exactly
      what the SDK's own no-permissions policy exists to avoid.
    -->
    <queries>
        <package android:name="com.google.android.gms" />
        <package android:name="com.android.vending" />
    </queries>

    <!--
      allowBackup="false" is what denies cloud backup, and it does that at every level this app
      supports. From Android 12 it stopped governing device-to-device transfer, which is what
      dataExtractionRules denies.

      Lint asks for fullBackupContent alongside it, on the grounds that dataExtractionRules applies
      only from 12. That rule is written for an app whose backup is on: below 12 there is no backup
      here at all, so a full-backup-content file would describe something that never happens.
    -->
    <application
        android:name=".PayabliDemoApplication"
        tools:ignore="DataExtractionRules"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PayabliDemo">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PayabliDemo"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
