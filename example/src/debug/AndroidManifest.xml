<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only. Points the app at the cleartext allowance for the local token server; a release build
  never sees this file, so it ships with the platform default of cleartext denied.

  Lint reports this attribute as unused below API 24, which is accurate and harmless: an API 23
  device has no network security config at all and permits cleartext outright, so the token server is
  reachable there without it. The attribute is what makes 24 and above behave the same way.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
