<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only. Points the app at the cleartext allowance for the local token server; a release build
  never sees this file, so it ships with cleartext denied.

  usesCleartextTraffic is false here and in the main manifest, and the config is what permits the
  two local addresses. The platform documents the precedence: "This flag is ignored on Android 7.0
  (API level 24) and above if an Android Network Security Config is present." The module's minSdk is
  24, so the config governs on every device this app runs on and the flag never decides anything.
  Below 24 it would, which is the other half of why the floor is 24 rather than the 23 the SDK
  modules build against.

  allowBackup and dataExtractionRules are repeated from the main manifest. The merged values are the
  same either way; stating them here keeps the file readable on its own, since a reader looking at
  what the debug variant permits should not have to open a second file to learn what it stores.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false" />
</manifest>
